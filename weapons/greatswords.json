[
  {"id":"greatswords01","name":"大劍","class":"greatswords","image":"images/weapons/colossal/greatswords01.jpg","重量":9,"能力需求":{"力量":16,"敏捷":13,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"C","敏捷":"D","智力":"—","信仰":"—","感應":"—"},"戰技":"獅子斬","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"大劍就是神，在大劍還沒有加強的時候，在劍花真連壓迫其它大劍出場空間的時候，我就在A門玩這個大劍了。pve方面，大前期就拿得到，自帶神戰技獅子斬，面板也不錯，重擊的特殊突刺模組和不俗的削韌，其實是足以通關的武器，只不過過於樸實無華，導致大家知道的比較少，實際上除了面對火焰巨人這種血牛，其它的boss都能夠勝任。萌新的話，復讀獅子斬到點數夠了換巨劍復讀獅子斬就行，但是對於大劍信仰的老ass來說，這把大劍足以。pvp方面，有個人把這個大劍玩到頂尖水平了，變節奏抓滾抓到死，是最體現雙方基本功的武器。"},
  {"id":"greatswords02","name":"鐵製大劍","class":"greatswords","image":"images/weapons/colossal/greatswords02.jpg","重量":12,"能力需求":{"力量":18,"敏捷":10,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"C","敏捷":"E","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"鐵制大劍，物理面板最高的大劍，但是短，獲得偏後期，沒什麼使用價值。偉哉卡利亞指定發射器，面板很高。"},
  {"id":"greatswords03","name":"君王直大劍","class":"greatswords","image":"images/weapons/colossal/greatswords03.jpg","重量":9,"能力需求":{"力量":16,"敏捷":10,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"D","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"君王軍大劍，年輕人的第一把大劍，對付人形敵人時（這裡代指能艹飛的所有敵人），箭步上砍比獅子斬壓迫力更強。箭步動作自帶忍耐，絕無被打斷可能（除了投技和韌性bug）"},
  {"id":"greatswords04","name":"騎士大劍","class":"greatswords","image":"images/weapons/colossal/greatswords04.jpg","重量":10,"能力需求":{"力量":16,"敏捷":12,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"C","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"騎士大劍，也叫劍花大劍，是pvp熱門武器，在1.09版本加強之後反而更難觸發真連了，但是仍然吃到了大劍增強的所有紅利，有着重擊和輕擊一樣快的離譜模組，長度和傷害都不錯，還可以更換戰灰，pvp很好用。"},
  {"id":"greatswords05","name":"失鄉騎士大劍","class":"greatswords","image":"images/weapons/colossal/greatswords05.jpg","重量":10,"能力需求":{"力量":17,"敏捷":9,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"D","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"失鄉騎士大劍，面板不俗，獲取方便，面板高，前期的神，力量號一開始刷一把厚重質變雙手握持，戰灰劍舞，跳批或者重擊命中接劍舞，隨隨便便2000傷。"},
  {"id":"greatswords06","name":"分岔大劍","class":"greatswords","image":"images/weapons/colossal/greatswords06.jpg","重量":9,"能力需求":{"力量":14,"敏捷":16,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"D","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":55,"凍傷":0,"中毒":0,"腐敗":0},"評價":"分岔大劍，自帶出血，但是刷它不太方便，又有焰形大劍，沒什麼出場空間，要是有經典小偷（小石像鬼）的特殊重擊動作，就還算有點特色。"},
  {"id":"greatswords07","name":"焰形大劍","class":"greatswords","image":"images/weapons/colossal/greatswords07.jpg","重量":10,"能力需求":{"力量":12,"敏捷":14,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"C","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":55,"凍傷":0,"中毒":0,"腐敗":0},"評價":"焰形大劍，分岔大劍的上位替代，自帶出血，可以神秘質變達到面板和出血值的雙贏。搭配盲擊輸出爆炸（但是盲擊有更好的選擇）。"},
  {"id":"greatswords08","name":"石像鬼黑劍","class":"greatswords","image":"images/weapons/colossal/greatswords08.jpg","重量":11.5,"能力需求":{"力量":18,"敏捷":10,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"E","智力":"—","信仰":"—","感應":"—"},"戰技":"尸蠟斬擊","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"石像鬼黑劍，聖屬性，不用說了吧，不過戰灰獨一個，也有燒血，可以拿來收藏，多周目多到你都不想要。"},
  {"id":"greatswords09","name":"緊密孿生劍","class":"greatswords","image":"images/weapons/colossal/greatswords09.jpg","重量":10,"能力需求":{"力量":18,"敏捷":18,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"D","智力":"—","信仰":"C","感應":"—"},"戰技":"神聖刀刃","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"緊密孿生劍，挺好看的。面板很不錯，神聖刀刃附魔了之後更為恐怖。對死之鳥寶具。"},
  {"id":"greatswords10","name":"瑪雷家行刑劍","class":"greatswords","image":"images/weapons/colossal/greatswords10.jpg","重量":11.5,"能力需求":{"力量":24,"敏捷":14,"智力":0,"信仰":0,"感應":23},"補正":{"力量":"C","敏捷":"E","智力":"—","信仰":"","感應":"D"},"戰技":"歐赫劍舞","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"瑪雷家行刑劍，神，對敵人硬直的時候來一發這個比處決傷害高多了，疊上護符加上buff來一發戰技秒殺任何boss，但是比較難用出來，對龜龜寶具（帶上上buff時間懺悔個兩分鐘就夠又吃腐敗翼劍徽章，又吃米莉森義手，又吃連擊靈藥，又吃法術靈藥，又吃魔力對蠍，又吃魔法之境又吃亞歷山大碎片，又吃夏波利利嘶吼，又吃黃金樹立誓，傷害高啊。"},
  {"id":"greatswords11","name":"奧陶琵斯大劍","class":"greatswords","image":"images/weapons/colossal/greatswords11.jpg","重量":12,"能力需求":{"力量":25,"敏捷":13,"智力":0,"信仰":15,"感應":0},"補正":{"力量":"C","敏捷":"E","智力":"—","信仰":"D","感應":"—"},"戰技":"奧陶琵斯的旋渦","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"奧陶琵斯大劍，好用，雖然有聖屬性，但是主要是物理面板，加強之後戰技有點霸體，削韌高，傷害還不錯，壓制力強。但是對於新手來說，要拿到不容易。"},
  {"id":"greatswords12","name":"白王劍","class":"greatswords","image":"images/weapons/colossal/greatswords12.jpg","重量":8,"能力需求":{"力量":16,"敏捷":12,"智力":18,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"E","智力":"D","信仰":"—","感應":"—"},"戰技":"白王引力波","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"白王劍，網紅劍，因為加強了大劍重擊模組，白王劍的特殊重擊倍率凸顯出來了，可以用，但是沒到吹的那種水平。戰技被碎星大劍完爆。"},
  {"id":"greatswords13","name":"死亡勾棒","class":"greatswords","image":"images/weapons/colossal/greatswords13.jpg","重量":8.5,"能力需求":{"力量":15,"敏捷":17,"智力":11,"信仰":0,"感應":0},"補正":{"力量":"C","敏捷":"B","智力":"D","信仰":"—","感應":"—"},"戰技":"點燃靈火","異常":{"出血":0,"凍傷":65,"中毒":0,"腐敗":0},"評價":"死亡勾棒，神。有特殊重擊模組，pvp有點用。主要是戰技。輕擊打滿傷害爆炸高，不過比較難打滿。即使打不滿傷害還是很高。重擊有擊倒衝擊力。輕重擊還有極高凍傷累計。非常強。戰技傷害在大劍里比褻瀆高不少，僅次於行刑劍，凍傷速度非常快，打薩米爾也是一個戰技出凍傷，等於自帶易傷效果，適合與火焰重罪一起使用。"},
  {"id":"greatswords14","name":"赫芬尖塔劍","class":"greatswords","image":"images/weapons/colossal/greatswords14.jpg","重量":11.5,"能力需求":{"力量":19,"敏捷":10,"智力":22,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"E","智力":"D","信仰":"—","感應":"—"},"戰技":"毀滅靈火","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"赫芬尖塔劍，主要是帥，智力高的情況下面板不錯，戰技附魔之後凍傷累計也挺高，可以一用。還可以搞出來這個違法違禁但是很帥的東西。這把劍的尷尬在於有死亡鉤棒和暗月大劍這兩種上位替代，只能說既生瑜何生亮。壓級甚至能對標魂的傳火大劍的存在。自帶雙屬性極高初始面板加上最高的那一檔面板附魔和凍傷"},
  {"id":"greatswords15","name":"褻瀆聖劍","class":"greatswords","image":"images/weapons/colossal/greatswords15.jpg","重量":13.5,"能力需求":{"力量":22,"敏捷":15,"智力":0,"信仰":21,"感應":0},"補正":{"力量":"D","敏捷":"D","智力":"—","信仰":"D","感應":"—"},"戰技":"褻瀆火焰","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"褻瀆聖劍，艾爾登法環唯一指定真神武器，輪椅已經不能形容，應該是擔架武器。傷害高，火屬性，戰技長，高衝擊，高削韌，戰技回血，殺敵回血。完美吃到火賜buff，而且能享受到的buff非常多。神中神，拿到了它，就拿到了艾爾登法環。"},
  {"id":"greatswords16","name":"混種大劍","class":"greatswords","image":"images/weapons/colossal/greatswords16.jpg","重量":9,"能力需求":{"力量":16,"敏捷":10,"智力":0,"信仰":0,"感應":0},"補正":{"力量":"D","敏捷":"D","智力":"—","信仰":"—","感應":"—"},"戰技":"箭步（上砍）","異常":{"出血":0,"凍傷":0,"中毒":0,"腐敗":0},"評價":"混種大劍，可以用，強度不錯（相比於單直），但是和其它的各個大劍比，沒有什麼長處。"}
